{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "GM_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release (with debug info)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "asan",
            "displayName": "Debug + REAL ASan/UBSan (zig + extracted libasan)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/zig-asan-toolchain.cmake"
            },
            "description": "Requires tools/qa/install-asan-runtime.sh. Never use -fsanitize=address,undefined: zig silently drops ASan."
        },
        {
            "name": "dev",
            "displayName": "Day-to-day Debug build (build/dev)",
            "description": "Debug build for editing/stepping. Same flags as 'debug', only a stable build directory so tools/dev.sh can reuse it.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "$env{HOME}/tools/sdl3",
                "GM_USE_PCH": "ON"
            }
        },
        {
            "name": "test",
            "displayName": "Optimised test build (build/test)",
            "description": "RelWithDebInfo twin of 'dev'. Same tests, no NDEBUG-dependent checks in the engine (there are no assert()s), ~4x faster test run. Use it for the inner loop; use 'dev' when a debugger is needed.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/test",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_PREFIX_PATH": "$env{HOME}/tools/sdl3",
                "GM_USE_PCH": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "dev",
            "configurePreset": "dev"
        },
        {
            "name": "test",
            "configurePreset": "test"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "dev",
            "displayName": "All CTest tests on build/dev (Debug)",
            "configurePreset": "dev",
            "execution": {
                "jobs": 8
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test",
            "displayName": "All CTest tests on build/test (fast)",
            "configurePreset": "test",
            "execution": {
                "jobs": 8
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "quick",
            "displayName": "Fast CTest subset (label: quick)",
            "description": "Everything except the SBV frame-hash sweep and the Python parity sweep. Meant for the inner loop; it is a subset, never a replacement for a full run.",
            "inherits": "dev",
            "filter": {
                "include": {
                    "label": "quick"
                }
            }
        },
        {
            "name": "full",
            "displayName": "Heavy CTest tests (label: full)",
            "description": "The SBV frame-hash sweep and the Python parity sweep only.",
            "inherits": "dev",
            "filter": {
                "include": {
                    "label": "full"
                }
            }
        }
    ]
}
